# --- Base de données ---
DATABASE_URL=postgresql://tontine:tontine@localhost:5432/tontine?schema=public
POSTGRES_USER=tontine
POSTGRES_PASSWORD=tontine
POSTGRES_DB=tontine
POSTGRES_PORT=5432

# --- Redis / files ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- API ---
NODE_ENV=development
API_PORT=3051
API_URL=http://localhost:3051
WEB_URL=http://localhost:3050
CORS_ORIGINS=http://localhost:3050

# --- Sécurité / jetons ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ENCRYPTION_KEY=change-me-32-bytes-base64-key

# --- Fournisseurs (dev) ---
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
MOCK_PROVIDER_WEBHOOK_SECRET=dev-mock-webhook-secret
MOCK_PROVIDER_AUTO_CONFIRM=true
# Passer à true uniquement derrière un reverse proxy maîtrisé (sinon X-Forwarded-For
# permettrait de falsifier l'IP d'audit et de limitation de débit).
TRUST_PROXY=false

# --- SMTP / MailHog ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@tontine.local

# --- Application ---
APP_BASE_URL=http://localhost:3050
DEFAULT_CURRENCY=XAF
TZ=Africa/Douala

# --- Observabilité ---
LOG_LEVEL=debug
SENTRY_DSN=

# --- Outils ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
ADMINER_PORT=8080

# --- OTP de développement (laisser vide hors dev/test) ---
OTP_FIXED_CODE=
